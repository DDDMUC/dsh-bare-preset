{
  "name": "dsh-bare-preset",
  "version": "0.2.0",
  "description": "裸模模式：把「空系统提示词 + 零工具 + 零运行时上下文」这个 agent 预设置成一个插件 —— 自己向 agentPresets 注册，并剪掉宿主塞进 agent 作用域的工具与上下文。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./persona": "./persona.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "persona.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDMUC/dsh-bare-preset.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "dsh",
    "preset",
    "agent-preset",
    "bare",
    "minimal-prompt"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  }
}
